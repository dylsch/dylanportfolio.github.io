rules_version = '2';

// Accounts. Paste into Firebase console → Firestore Database → Rules, then Publish.
// Replace YOUR_EMAIL@gmail.com with your Google account (keep your real email out of this public repo).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ledger/{uid} and everything under it: settings, clients, invoices, expenses, imports,
    // original documents and the Anthropic API key. Only the owner, and only their own ledger.
    match /ledger/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
