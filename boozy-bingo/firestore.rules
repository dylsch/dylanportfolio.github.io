rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Replace YOUR_EMAIL@gmail.com with the Google account that owns the app (keep your real email out of this public repo).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // allowed/{uid}: people the admin has approved. Only the admin can change it.
    match /allowed/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow write: if isAdmin();
    }

    // requests/{uid}: a signed-in user may file one pending request for themselves.
    match /requests/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // games/{gameId}: live games. The secret game id is only shared through the host's QR code.
    function isHost() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/allowed/$(request.auth.uid)));
    }
    match /games/{gameId} {
      allow get: if signedIn();
      allow create: if isHost() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isHost() && resource.data.hostUid == request.auth.uid;

      // Players join anonymously from their phones. They can only touch their own entry,
      // can't change their card once dealt, and can't write their own bingo verdict.
      match /players/{uid} {
        function game() { return get(/databases/$(database)/documents/games/$(gameId)).data; }
        function isGameHost() { return signedIn() && game().hostUid == request.auth.uid; }
        function validName() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 30;
        }
        allow get: if isSelf(uid) || isGameHost();
        allow list: if isGameHost();
        allow create: if isSelf(uid) && game().open == true && validName()
          && request.resource.data.keys().hasOnly(['name', 'card', 'joinedAt', 'answers', 'times', 'bingoAt']);
        allow update: if isGameHost()
          || (isSelf(uid) && validName()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'answers', 'times', 'bingoAt']));
        allow delete: if isGameHost();
      }
    }

    // stats/{uid}/games/{id}: each host's private game history.
    match /stats/{uid}/games/{gameId} {
      allow read, write: if isSelf(uid) && isHost();
    }

    // santa/{drawId}: Secret Santa draws. Each participant's page is read with the secret token in
    // their private link (no sign-in needed); pages can't be listed, so nobody can browse other matches.
    match /santa/{drawId} {
      function isOrganiser() { return isHost() && get(/databases/$(database)/documents/santa/$(drawId)).data.hostUid == request.auth.uid; }
      allow create: if isHost() && request.resource.data.hostUid == request.auth.uid;
      allow get, update, delete: if isHost() && resource.data.hostUid == request.auth.uid;

      match /reveals/{token} {
        allow get: if true;
        allow list: if false;
        allow create, delete: if isOrganiser();
        // The participant may only stamp the moment they first opened their match.
        allow update: if resource.data.openedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])
          && request.resource.data.openedAt == request.time;
      }
      match /wishes/{wishId} {
        allow get: if true;
        allow list: if false;
        allow create, delete: if isOrganiser();
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlist', 'updatedAt'])
          && request.resource.data.wishlist is string
          && request.resource.data.wishlist.size() <= 1000
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
